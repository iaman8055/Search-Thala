MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/search_thala?retryWrites=true&w=majority

# Optional: Upstash Redis (REST API) for caching article list responses.
# If unset, the app falls back to querying MongoDB directly on every request.
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-token>
